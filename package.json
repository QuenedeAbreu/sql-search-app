{
  "name": "sql-search-app",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "chardet": "^2.1.1",
    "chokidar": "^5.0.0",
    "iconv-lite": "^0.7.2",
    "monaco-editor": "^0.55.1"
  },
  "build": {
    "appId": "com.sqlsearch.app",
    "productName": "SQL Search PRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "sql_search.ico"
    }
  }
}
